{
  "manifest_version": 3,
  "name": "FB Marketplace Manager",
  "version": "1.0.0",
  "description": "Manage, monitor, and optimize your Facebook Marketplace listings.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "http://localhost:3333/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace*"],
      "js": ["src/selectors.js", "src/scraper.js", "src/autofill.js", "src/content.js"],
      "css": ["src/sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/inbox*",
        "https://www.facebook.com/marketplace/t/*"
      ],
      "js": ["src/selectors.js", "src/marketplace-chat.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
